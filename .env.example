# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Gates mock/illustrative admin dashboard figures (gross booking volume,
# platform fees, aspirational future-market rows) — must be unset or
# "false" in production so the admin portal never shows fabricated numbers
# as if they were live. Set to "true" only for demos/screenshots.
NEXT_PUBLIC_DEMO_MODE="false"
# The homepage's "Request Freight Quotes" language implies a multi-carrier
# bidding/comparison workflow that doesn't exist yet (see README). Keep
# unset/false until FreightQuoteRequest/FreightQuote are built — the
# homepage falls back to "Post a Freight Load" instead.
NEXT_PUBLIC_FREIGHT_QUOTE_REQUESTS_ENABLED="false"
# Drives the homepage hero's location badge and backdrop image via
# config/markets.ts / lib/active-market.ts — never hardcode the city name
# in the hero component itself. Falls back to indianapolis if unset,
# misspelled, or pointed at a market not yet approved for launch
# (isActive: false in config/markets.ts).
NEXT_PUBLIC_ACTIVE_MARKET="indianapolis"
NODE_ENV="development"
AUTH_SECRET="replace-with-a-long-random-secret"
# Shared secret for triggering scheduled jobs (e.g. FMCSA reverification)
# from Vercel Cron or an external scheduler — see README "Deployment".
CRON_SECRET="replace-with-a-long-random-secret"

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tempmovers"
# Only needed if your provider pools DATABASE_URL and requires a separate
# unpooled connection for migrations (e.g. Neon, PgBouncer setups).
DIRECT_URL=""

# Stripe payments, Connect, and subscriptions
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CONNECT_CLIENT_ID=""
STRIPE_CONNECT_RETURN_URL="http://localhost:3000/mover/settings?stripe=return"
STRIPE_CONNECT_REFRESH_URL="http://localhost:3000/mover/settings?stripe=refresh"
STRIPE_MOVER_SUBSCRIPTION_PRICE_ID="price_..."
STRIPE_DRIVER_BASIC_PRICE_ID="price_..."
STRIPE_OWNER_OPERATOR_PRO_PRICE_ID="price_..."
STRIPE_FLEET_PRICE_ID="price_..."
STRIPE_FLEET_EXTRA_VEHICLE_PRICE_ID="price_..."

# Resend — the only transactional email provider (see lib/email/resend.ts).
# No SendGrid variables — that provider was never actually integrated and
# is not used anywhere in this codebase.
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
EMAIL_FROM="TempMovers <no-reply@tempmovers.com>"
EMAIL_REPLY_TO="support@tempmovers.com"

# Twilio — phone verification (Verify) and SMS (see lib/twilio.ts)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_PHONE_NUMBER=""

# Mapping and geo targeting — separate browser/server keys on purpose: the
# browser key should be domain-restricted, the server key IP-restricted.
# A single shared key can't carry both restriction types at once.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
GOOGLE_MAPS_SERVER_KEY=""

# Checkr — background checks (see lib/checkr.ts). Separate packages for
# movers vs. commercial drivers since required scope differs.
CHECKR_API_KEY=""
# Confirm with Checkr whether this should be the account API key or a
# partner client secret, depending on the selected integration model.
CHECKR_WEBHOOK_SECRET=""
# Only required if the Checkr account uses hierarchy nodes.
CHECKR_NODE_CUSTOM_ID=""
CHECKR_MOVER_PACKAGE=""
# Separate packages per driver type — box-truck vs. semi require different
# scope (MVR only vs. CDL+MVR+DOT+MC). Used by lib/screening/packages.ts,
# the single source of truth for Checkr package selection.
CHECKR_BOX_TRUCK_PACKAGE=""
CHECKR_SEMI_PACKAGE=""

# Carrier verification (FMCSA QCMobile — public API, real client in lib/fmcsa.ts)
FMCSA_WEB_KEY=""
FMCSA_API_BASE_URL="https://mobile.fmcsa.dot.gov/qc/services"
FMCSA_REVERIFY_DAYS="30"

# Private document storage — S3-compatible (see lib/storage.ts). Bucket must
# block all public access; documents are only ever reachable through
# short-lived signed URLs.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION=""
AWS_S3_BUCKET=""
AWS_S3_KMS_KEY_ID=""

# Certificial — insurance monitoring (see lib/certificial.ts)
CERTIFICIAL_API_KEY=""
CERTIFICIAL_WEBHOOK_SECRET=""

# Sentry — production error monitoring (see sentry.*.config.ts, lib/monitoring.ts)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# External semi-truck freight sources (Priority 1) — see lib/load-board-adapter.ts.
# Every adapter for these is currently an honest "not configured" stub; none
# of them have verified API contracts, contract rights, or certification in
# this codebase yet. Do not activate before that work is done — see README.
DAT_CLIENT_ID=""
DAT_CLIENT_SECRET=""
DAT_API_KEY=""
DAT_API_BASE_URL=""
DAT_WEBHOOK_SECRET=""

TRUCKSTOP_API_BASE_URL=""
TRUCKSTOP_CLIENT_ID=""
TRUCKSTOP_CLIENT_SECRET=""
TRUCKSTOP_API_KEY=""
TRUCKSTOP_PARTNER_USER_ID=""
TRUCKSTOP_WEBHOOK_SECRET=""

# Later freight sources (Priority 2) — same "not configured" stub status,
# and gated behind DAT or a direct verified load partner being operational
# first, per the launch-integrations handoff.
LOADBOARD_123_API_KEY=""
LOADBOARD_123_CLIENT_ID=""
LOADBOARD_123_CLIENT_SECRET=""
LOADBOARD_123_BASE_URL=""

UBER_FREIGHT_CLIENT_ID=""
UBER_FREIGHT_CLIENT_SECRET=""
UBER_FREIGHT_API_BASE_URL=""
UBER_FREIGHT_WEBHOOK_SECRET=""

DIRECT_FREIGHT_API_TOKEN=""
DIRECT_FREIGHT_BASE_URL=""
