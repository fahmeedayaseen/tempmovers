model PartnerMarket {
  id        String @id @default(cuid())
  partnerId String
  partner   PartnerOrganization @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  marketId  String
  market    LaunchMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  active    Boolean @default(true)
  createdAt DateTime @default(now())
  @@unique([partnerId, marketId])
}

// Market/territory-scoped admin access. A MARKET-scope assignment must
// never implicitly grant PLATFORM-wide reach — enforcement lives in
// lib/market-access.ts, not in the shape of this table alone.
model AdminAssignment {
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope       AdminScope
  state       String?
  marketId    String?
  market      LaunchMarket? @relation(fields: [marketId], references: [id], onDelete: Cascade)
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  active      Boolean @default(true)
  createdAt   DateTime @default(now())
  @@index([userId, active])
  @@index([marketId])
  @@index([territoryId])
}

// Per-market/territory fee overrides, layered platform -> state -> market ->
// territory (see lib/pricing-resolver.ts). Null fields fall through to the
// next-broader layer rather than forcing every market to restate every fee.
model MarketPricingRule {
  id          String @id @default(cuid())
  marketId    String
  market      LaunchMarket @relation(fields: [marketId], references: [id], onDelete: Cascade)
  territoryId String?
  territory   Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  scheduledFeeCents      Int?
  urgentFeeCents         Int?
  bookingProtectionCents Int?
  minimumMovers          Int?
  minimumHours           Int?
  // The platform-controlled mover wage rate for this market/tier — movers do
  // not set their own hourly rate and customers do not choose it; this (or
  // the fallback default in lib/pricing-rules.ts when no rule exists yet
  // for a market) is the only source of truth for what a job pays movers.
  moverHourlyRateCents   Int?
  boxTruckFeeCents       Int?
  semiFeePercent         Decimal? @db.Decimal(5,2)
  semiFeeCapCents        Int?

  effectiveAt DateTime
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  @@index([marketId, effectiveAt])
  @@index([territoryId, effectiveAt])
}

enum AdminScope {
  PLATFORM
  STATE
  MARKET
  TERRITORY
}

enum TerritoryStatus {
  PLANNED
  RECRUITING
  ACTIVE
  PAUSED
  CLOSED
}

enum TerritoryType {
  CITY
  COUNTY
  METRO
  ZIP_CLUSTER
  RADIUS
  CUSTOM_BOUNDARY
}

// Immutable financial history for bonuses. A PAID award is never rewritten —
// a refund/chargeback after payout creates a RECOVERY entry that reduces the
// recipient's future payable balance instead of altering what already
// happened. See lib/bonus-ledger.ts.
model BonusLedgerEntry {
  id           String @id @default(cuid())
  bonusAwardId String
  bonusAward   BonusAward @relation(fields: [bonusAwardId], references: [id], onDelete: Restrict)

  type           BonusLedgerEntryType
  amountCents    Int
  reason         String
  relatedJobId   String?
  relatedRouteId String?
  stripeEventId  String?

  // Ties an ADJUSTMENT entry (recovery applied against a payout) to the
  // specific payout it was reserved for. The unique constraint below is
  // what makes a retried payout attempt a no-op instead of reserving the
  // same recovery amount twice.
  payoutId String?
  payout   Payout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  @@index([bonusAwardId, createdAt])
  // Idempotent per (bonus award, Stripe event) pair, not per event alone —
  // one refund can affect several bonus awards tied to the same job/load,
  // and each needs its own recovery entry, not just the first one.
  @@unique([bonusAwardId, stripeEventId, type])
  @@unique([payoutId, type])
}

enum BonusLedgerEntryType {
  AWARD
  PAYMENT
  RECOVERY
  ADJUSTMENT
}

// CarrierRoute is the freight "load" record. Fields are grouped and commented by
// exposure level — the /api/loads (public) endpoint must only ever select the
// PUBLIC-SAFE group; the sensitive group is readable only by the shipper who
// posted it, an assigned/verified carrier, or an admin.
model CarrierRoute {
  id                    String @id @default(cuid())
  partnerOrganizationId String?
  partnerOrganization   PartnerOrganization? @relation(fields: [partnerOrganizationId], references: [id], onDelete: SetNull)
  postedByUserId        String?
  postedByUser          User? @relation("PostedLoads", fields: [postedByUserId], references: [id], onDelete: SetNull)

  // --- PUBLIC-SAFE fields: safe to return from the public load board ---
  title               String
  visibility          RouteVisibility @default(PUBLIC_PREVIEW)
  status              LoadStatus @default(OPEN)
  originCity          String
  originState         String
  originZip           String?
  originMarketId        String?
  originMarket          LaunchMarket? @relation("RouteOrigin", fields: [originMarketId], references: [id], onDelete: SetNull)
  originTerritoryId     String?
  originTerritory       Territory?    @relation("RouteOriginTerritory", fields: [originTerritoryId], references: [id], onDelete: SetNull)
  originLatitude        Decimal? @db.Decimal(9,6)
  originLongitude       Decimal? @db.Decimal(9,6)
  needsManualGeoReview  Boolean  @default(false)
  destinationCity     String
  destinationState    String
  destinationMarketId   String?
  destinationMarket     LaunchMarket? @relation("RouteDestination", fields: [destinationMarketId], references: [id], onDelete: SetNull)
  destinationTerritoryId String?
  destinationTerritory   Territory?  @relation("RouteDestinationTerritory", fields: [destinationTerritoryId], references: [id], onDelete: SetNull)
  destinationLatitude    Decimal? @db.Decimal(9,6)
  destinationLongitude   Decimal? @db.Decimal(9,6)
  equipmentType       VehicleType
  detailedEquipmentType EquipmentType?
  // Provider tracking for external load-board sourced freight. INTERNAL
  // (the default) means this load originated on TempMovers' own
  // marketplace — the primary source per the box-truck/final-mile strategy.
  // The unique constraint below is the actual dedup enforcement: two syncs
  // of the same external load can never create two CarrierRoute rows.
  sourceProvider      LoadBoardProvider @default(INTERNAL)
  externalLoadId      String?
  externalSyncStatus  ExternalSyncStatus @default(NOT_SYNCED)
  lastSyncedAt        DateTime?
  pickupDate          DateTime
  estimatedHoursOrMiles String
  stopCount           Int @default(0)
  liftgateRequired    Boolean @default(false)
  cdlRequired         Boolean @default(false)
  isLocalRoute         Boolean @default(false)
  grossCarrierCents   Int
  // Which pricing model produced grossCarrierCents. Business decision: box-truck
  // and semi owner-operators are paid a flat guaranteed amount per load, not an
  // hourly wage — they supply their own truck, fuel, insurance, and maintenance.
  // HOURLY stays available only for a driver-only booking where the customer
  // supplies the truck — see serviceType, which is what actually enforces that
  // HOURLY can't be selected for a normal owner-operator load.
  pricingModel        FreightPricingModel @default(FLAT_RATE)
  serviceType         FreightServiceType  @default(OWNER_OPERATOR_BOX_TRUCK)
  // How this load's platform fee relates to price/payout, frozen at posting.
  // ADD_TO_CUSTOMER: grossCarrierCents is the carrier's full gross; customer
  // pays gross + fee. DEDUCT_FROM_PROVIDER: grossCarrierCents is the carrier's
  // NET (posted price - fee); customer pays the posted price. Self-describing
  // for settlement/refund/audit.
  feeModel            FeeModel @default(DEDUCT_FROM_PROVIDER)
  platformFeeCents    Int
  // Explicit, self-describing money breakdown (handoff requirement) so every
  // consumer and report reads a stored value rather than re-deriving it:
  //   grossLoadAmountCents  — the full load/gross figure the pricing used
  //                           (the posted price in DEDUCT, the carrier gross
  //                           in ADD). grossCarrierCents remains "what the
  //                           carrier is owed" for back-compat with existing
  //                           settlement/invoice readers.
  //   carrierNetPayoutCents — what the carrier actually receives (= net).
  //   customerTotalCents    — what the customer/shipper actually pays.
  // Invariant: customerTotalCents - carrierNetPayoutCents == platformFeeCents
  // (plus customer-side accessorials/urgent, which raise customerTotalCents
  // only). All integer cents.
  grossLoadAmountCents  Int @default(0)
  carrierNetPayoutCents Int @default(0)
  customerTotalCents    Int @default(0)
  // Detention/waiting is billed separately from the base flat rate, not folded
  // into it — a load that runs long at the dock shouldn't silently absorb that
  // time into what was quoted as a fixed price.
  waitTimeIncludedMinutes Int @default(60)
  waitTimeRateCents       Int @default(0)
  accessorialsCents       Int @default(0)

  // Detention/waiting-time tracking. calculateDetention() in lib/pricing.ts
  // computes detentionCents from these once actualWaitTimeMinutes is known;
  // nothing here automatically modifies a PaymentIntent — see that
  // function's doc comment for why this is deliberately left as a
  // calculation only, not a capture action.
  arrivedAt             DateTime?
  loadingStartedAt      DateTime?
  departedPickupAt      DateTime?
  arrivedDeliveryAt     DateTime?
  actualWaitTimeMinutes Int?
  detentionCents        Int @default(0)
  detentionApprovedAt   DateTime?
  detentionApprovedById String?
  detentionCharges      DetentionCharge[]
  partnerInvoiceLine    PartnerInvoiceLine?
  // Not yet enforced anywhere — added so either answer to "does the
  // customer need to approve detention before it's charged" is ready to
  // wire in once decided, without another schema migration. See README.
  detentionCustomerApprovedAt   DateTime?
  detentionCustomerApprovedById String?
  // If the commercial agreement authorizes automatic detention billing
  // instead, that consent should be recorded here at booking time, not
  // inferred after the fact.
  detentionAutoBillingConsentedAt DateTime?
  stripePaymentIntentId String?       @unique
  paymentStatus         PaymentStatus @default(REQUIRES_PAYMENT_METHOD)
  paymentAttempts       PaymentAttempt[]
  paymentTransactions   PaymentTransaction[]
  tips                  Tip[]

  exactPickupAddress    String?
  exactDeliveryAddress  String?
  shipperContactName    String?
  shipperContactPhone   String?
  commodityDescription  String?
  accessCode            String?
  privateDocumentUrl    String?

  // --- Assignment / fulfillment (visible to assigned carrier + admin only) ---
  assignedWorkerId    String?
  assignedWorker      WorkerProfile? @relation(fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  assignedDriverContactPhone String?
  requiresDotMcVerification Boolean @default(true)
  proofOfDeliveryUrl  String?
  signatureUrl         String?
  settlementId          String?
  settlement            Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  externalSource      String?
  externalReference   String?
  invitations         CarrierRouteInvitation[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  @@index([visibility, status])
  @@index([originMarketId, status])
  @@index([destinationMarketId])
  bookingAccessorials BookingAccessorial[]
  @@unique([sourceProvider, externalLoadId])
  @@index([sourceProvider, externalSyncStatus])
  @@index([equipmentType, isLocalRoute])
}

model Settlement {
  id            String   @id @default(cuid())
  workerId      String
  worker        WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  loadsSettled  Int      @default(0)
  grossCents    Int      @default(0)
  adjustmentsCents Int   @default(0)
  netCents      Int      @default(0)
  status        PayoutStatus @default(PENDING)
  approvedAt    DateTime?
  approvedById  String?
  stripeTransferId String? @unique
  idempotencyKey   String? @unique
  paidAt        DateTime?
  // Distinct from paidAt above (set at TRANSFERRED time) — this is the
  // true bank-arrival confirmation from payout.paid.
  paidOutAt     DateTime?
  stripePayoutId String?
  failedAt      DateTime?
  failureReason String?
  reversedAt    DateTime?
  createdAt     DateTime @default(now())
  loads         CarrierRoute[]
  detentionLines SettlementDetentionLine[]
}

// Stripe redelivers webhook events on any non-2xx response or timeout, and the
// same event can legitimately arrive twice under normal operation. Recording
// processed event IDs here — and checking/inserting at the top of the webhook
// handler inside the same transaction as the state change — is what makes
// reprocessing a no-op instead of double-crediting a payment or payout.
// PROCESSING is written BEFORE business logic runs, COMPLETED only after it
// succeeds. This is what lets a genuine mid-processing failure be retried by
// Stripe instead of being permanently swallowed as "already handled" — the
// old version recorded the event as done up front, so a failure partway
// through (e.g. the DB write for a refund) could silently lose that update
// forever, since the retry would see the row and bail out.
model ProcessedStripeEvent {
  id           String   @id
  type         String
  status       StripeEventProcessingStatus
  attemptCount Int      @default(1)
  lastError    String?
  startedAt    DateTime @default(now())
  completedAt  DateTime?
  updatedAt    DateTime @updatedAt
}

enum StripeEventProcessingStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model FeatureFlag {
  id          String @id @default(cuid())
  key         String @unique
  enabled     Boolean @default(false)
  description String?
  // Feature-flag framework (future-development extension points). Targeting
  // is ADDITIVE and OFF by default: a flag is on for a request only when
  // `enabled` is true AND the request matches any configured targeting (an
  // empty/naked list means "no restriction on that dimension"). All future
  // features ship disabled; nothing here touches booking/payment/settlement/
  // reconciliation — the gate is read-only advisory that callers opt into.
  status          FeatureFlagStatus @default(DISABLED)
  enabledEnvironments String[]  // e.g. ["development","staging"] — empty = any env
  enabledMarkets      String[]  // LaunchMarket ids — empty = all markets
  enabledRoles        UserRole[] // empty = all roles
  enabledServiceTypes String[]  // e.g. ["MOVING","SEMI"] — empty = all
  enabledPilotGroups  String[]  // arbitrary cohort tags — empty = none required
  configuration   Json?         // per-feature config blob (opaque to the gate)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum FeatureFlagStatus {
  DISABLED   // hard off regardless of targeting
  PILOT      // on only for matching pilot groups / targeting
  ENABLED    // on where targeting matches (or everywhere if no targeting)
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actor       User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  role         UserRole
  expiresAt    DateTime
  revokedAt    DateTime?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  @@index([userId, expiresAt])
}

// ===== Accessorial & Additional Charges Engine (P0) =====
// One configurable engine for additional charges across all services.
// Generalizes the existing bespoke detention pattern. See
// docs/TempMovers_Accessorial_Engine_Functional_Spec_v3 for the blueprint.

enum AccessorialServiceScope {
  MOVING
  LOCAL_BOX
  FREIGHT_BOX
  SEMI
}

enum AccessorialPricingShape {
  FLAT
  PERCENTAGE
  HOURLY
  MILEAGE
  PER_ITEM
  PER_FLIGHT
}

enum PlatformShareMode {
  FLAT_CENTS
  PERCENT_OF_CHARGE
}

enum BookingAccessorialStatus {
  PROPOSED
  APPROVED
  REJECTED
  SETTLED
}

// The catalog: WHAT can be charged + stable, non-price configuration.
// Pricing (rate + band + effective dates) lives in AccessorialMarketPrice.
model AccessorialType {
  id                 String   @id @default(cuid())
  key                String   @unique
  label              String
  serviceScope       AccessorialServiceScope[]
  pricingShape       AccessorialPricingShape
  platformShareMode  PlatformShareMode
  platformShareValue Int      // cents (FLAT_CENTS) or percent (PERCENT_OF_CHARGE)
  platformCapCents   Int?
  // Tax config: P0 STORES taxability; it does NOT compute tax.
  isTaxable          Boolean  @default(false)
  taxRuleCode        String?
  // Accounting/reporting.
  ledgerCode         String?
  reportingCategory  String?
  // Workflow flags (P1 workflow consumes these).
  requiresApproval   Boolean  @default(false)
  requiresEvidence   Boolean  @default(false)
  isActive           Boolean  @default(true)
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  marketPrices       AccessorialMarketPrice[]
  bookingAccessorials BookingAccessorial[]

  @@index([isActive, displayOrder])
}

// Per-market, effective-dated pricing for one accessorial. The resolver
// selects exactly one row for a booking's market + acceptance date.
model AccessorialMarketPrice {
  id                 String   @id @default(cuid())
  accessorialTypeId  String
  accessorialType    AccessorialType @relation(fields: [accessorialTypeId], references: [id], onDelete: Cascade)
  // NULL marketId = national/default fallback row.
  marketId           String?
  market             LaunchMarket? @relation(fields: [marketId], references: [id], onDelete: Cascade)
  territoryId        String?
  territory          Territory? @relation(fields: [territoryId], references: [id], onDelete: SetNull)

  // The ACTIVE rate the engine charges + advisory band.
  customerRateCents     Int
  defaultSuggestedPrice Int?
  recommendedPrice      Int?
  minimumPrice          Int?
  maximumPrice          Int?

  effectiveFrom      DateTime
  effectiveTo        DateTime?
  version            Int      @default(1)

  // Role-based band override (Super/Finance admin only; enforced server-side).
  bandOverride       Boolean  @default(false)
  bandOverrideReason String?

  isPublished        Boolean  @default(false)
  createdByUserId    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([accessorialTypeId, marketId, effectiveFrom])
  @@index([accessorialTypeId, isPublished])
}

// An accessorial actually applied to a booking, with a FROZEN price snapshot.
model BookingAccessorial {
  id                 String   @id @default(cuid())
  jobId              String?
  job                Job?     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  loadId             String?
  load               CarrierRoute? @relation(fields: [loadId], references: [id], onDelete: Cascade)
  accessorialTypeId  String
  accessorialType    AccessorialType @relation(fields: [accessorialTypeId], references: [id])

  // Frozen catalog + pricing snapshot (immutable once applied).
  typeKeySnapshot            String
  pricingShapeSnapshot       AccessorialPricingShape
  customerRateCentsSnapshot  Int
  platformShareModeSnapshot  PlatformShareMode
  platformShareValueSnapshot Int
  platformCapCentsSnapshot   Int?

  quantity           Decimal  @default(1) @db.Decimal(12, 4)
  customerChargeCents Int
  platformShareCents Int
  providerShareCents Int

  // Price source (audit trail): which AccessorialMarketPrice row produced this.
  priceSourceMarketId       String?
  priceSourceVersion        Int
  priceSourceEffectiveFrom  DateTime

  // Frozen tax/ledger for exports.
  isTaxableSnapshot  Boolean  @default(false)
  ledgerCodeSnapshot String?

  status             BookingAccessorialStatus @default(PROPOSED)
  approvedByUserId   String?
  approvedAt         DateTime?
  evidenceUrls       String[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([jobId, status])
  @@index([loadId, status])
  @@index([accessorialTypeId])
}

// ============================================================================
// Freight Load Management (freight phase) — DORMANT behind brokerage flags.
// Money in integer cents. Post-acceptance financial changes are versioned
// amendments, never silent overwrites. Every mutation is append-only audited.
// ============================================================================

enum FreightLoadStatus {
  DRAFT
  QUOTE_REQUESTED
  QUOTED
  BOOKED
  AVAILABLE
  OFFERED
  ACCEPTED
  DISPATCHED
  AT_PICKUP
  LOADED
  IN_TRANSIT
  AT_DELIVERY
  DELIVERED
  POD_PENDING
  COMPLETED
  INVOICED
  PAID
  CANCELED
  EXCEPTION
}

model FreightLoad {
  id                    String   @id @default(cuid())
  status                FreightLoadStatus @default(DRAFT)
  version               Int      @default(1)   // bumped on material term changes
  marketId              String?
  shipperUserId         String?
  // Commodity / equipment
  commodity             String?
  weightLbs             Int?
  palletCount           Int?
  equipmentType         String?
  loadRequirements      String?
  // Financials — integer cents ONLY.
  customerLinehaulCents      Int @default(0)
  customerFuelSurchargeCents Int @default(0)
  customerAccessorialsCents  Int @default(0)
  customerTotalCents         Int @default(0)
  carrierLinehaulCents       Int @default(0)
  carrierFuelSurchargeCents  Int @default(0)
  carrierAccessorialsCents   Int @default(0)
  carrierTotalCents          Int @default(0)
  grossMarginCents           Int @default(0)
  processingFeesCents        Int @default(0)
  platformRevenueCents       Int @default(0)
  // Assignment
  assignedCarrierId     String?
  // Idempotency for creation.
  creationKey           String?  @unique
  createdById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  stops                 FreightStop[]
  offers                CarrierOffer[]
  amendments            LoadFinancialAmendment[]
  rateConfirmations     RateConfirmation[]
  accessorials          LoadAccessorial[]
  auditEvents           FreightAuditEvent[]
  invoices              CustomerInvoice[]
  settlements           CarrierSettlement[]
  @@index([status, marketId])
  @@index([assignedCarrierId])
}

model FreightStop {
  id            String   @id @default(cuid())
  loadId        String
  load          FreightLoad @relation(fields: [loadId], references: [id], onDelete: Cascade)
  sequence      Int
  stopType      String   // PICKUP | DELIVERY | STOP
  city          String?
  state         String?
  zip           String?
  appointmentAt DateTime?
  @@index([loadId, sequence])
}

/** Versioned financial amendment — agreed rates are never silently overwritten. */
model LoadFinancialAmendment {
  id            String   @id @default(cuid())
  loadId        String
  load          FreightLoad @relation(fields: [loadId], references: [id], onDelete: Cascade)
  version       Int
  reason        String?
  customerTotalCents Int
  carrierTotalCents  Int
  grossMarginCents   Int
  createdById   String
  acknowledgedAt DateTime?
  createdAt     DateTime @default(now())
  @@unique([loadId, version])
}

enum CarrierOfferStatus {
  PENDING
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
  SUPERSEDED
}

model CarrierOffer {
  id                String   @id @default(cuid())
  loadId            String
  load              FreightLoad @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrierId         String
  offeredRateCents  Int
  status            CarrierOfferStatus @default(PENDING)
  expiresAt         DateTime
  sentAt            DateTime @default(now())
  viewedAt          DateTime?
  respondedAt       DateTime?
  declineReason     String?
  eligibilitySnapshot Json?   // structured result captured at offer time
  version           Int      @default(1)
  // At most one ACCEPTED offer per load — enforced in the accept transaction.
  createdAt         DateTime @default(now())
  @@index([loadId, status])
  @@index([carrierId, status])
}

model RateConfirmation {
  id            String   @id @default(cuid())
  loadId        String
  load          FreightLoad @relation(fields: [loadId], references: [id], onDelete: Cascade)
  loadVersion   Int
  carrierId     String
  agreedCarrierRateCents Int
  equipment     String?
  commodity     String?
  paymentTerms  String?
  documentRequirements String?
  cancellationProvisions String?
  signedDocumentId String?
  generatedAt   DateTime @default(now())
  acceptedAt    DateTime?
  version       Int      @default(1)
  @@index([loadId, version])
}

enum AccessorialKind {
  DETENTION
  LAYOVER
  LUMPER
  TONU
  DRIVER_ASSIST
  REDELIVERY
  STORAGE
  SCALE
  TOLL
  OTHER
}

enum AccessorialApprovalStatus {
  REQUESTED
  APPROVED
  REJECTED
}

model LoadAccessorial {
  id                 String   @id @default(cuid())
  loadId             String
  load               FreightLoad @relation(fields: [loadId], references: [id], onDelete: Cascade)
  kind               AccessorialKind
  requestedAmountCents Int
  approvedAmountCents  Int?
  supportingDocumentId String?
  requestedById      String
  approvalStatus     AccessorialApprovalStatus @default(REQUESTED)
  approvedById       String?
  customerBillable   Boolean @default(false)
  carrierPayable     Boolean @default(false)
  reason             String?
  createdAt          DateTime @default(now())
  @@index([loadId, approvalStatus])
}

enum CustomerInvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  PAST_DUE
  DISPUTED
  VOID
  WRITTEN_OFF
}

model CustomerInvoice {
  id            String   @id @default(cuid())
  loadId        String
  load          FreightLoad @relation(fields: [loadId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique
  chargesCents  Int
  accessorialsCents Int  @default(0)
  taxCents      Int      @default(0)
  totalCents    Int
  paymentTerms  String?
  dueDate       DateTime?
  status        CustomerInvoiceStatus @default(DRAFT)
  creationKey   String?  @unique   // idempotency
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([loadId, status])
}

enum CarrierSettlementStatus {
  PENDING
  PAYABLE
  PAID
  ON_HOLD
}

model CarrierSettlement {
  id            String   @id @default(cuid())
  loadId        String
  load          FreightLoad @relation(fields: [loadId], references: [id], onDelete: Cascade)
  carrierId     String
  finalAmountCents Int
  status        CarrierSettlementStatus @default(PENDING)
  // Verified factoring routing applied at settlement time (remit-to snapshot).
  remitToName   String?
  paymentAssignmentId String?
  creationKey   String?  @unique   // idempotency — prevents duplicate settlement
  approvedById  String?
  approvedAt    DateTime?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([loadId])   // at most one settlement per load
  @@index([carrierId, status])
}

/** Append-only freight audit trail. */
model FreightAuditEvent {
  id            String   @id @default(cuid())
  loadId        String
  load          FreightLoad @relation(fields: [loadId], references: [id], onDelete: Cascade)
  event         String   // LOAD_CREATED | STATUS_CHANGED | OFFER_ACCEPTED | ...
  detail        Json?
  actorId       String?
  createdAt     DateTime @default(now())
  @@index([loadId, createdAt])
}

model CarrierNote {
  id         String   @id @default(cuid())
  carrierId  String
  carrier    Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  body       String
  authorId   String
  createdAt  DateTime @default(now())
  @@index([carrierId, createdAt])
}

// ============================================================================
// Carrier Recruiting CRM — sales pipeline for recruiting carriers BEFORE
// brokerage activation. Prospects are DELIBERATELY separate from Carrier
// records: a prospect is a lead, a Carrier is an onboarded company. Conversion
// links the two. Recruiters never touch finance/factoring/compliance data —
// these models carry none of it.
// ============================================================================

enum RecruitmentStage {
  NEW_LEAD
  CONTACT_ATTEMPTED
  CONTACTED
  INTERESTED
  APPLICATION_SENT
  APPLICATION_STARTED
  DOCUMENTS_PENDING
  UNDER_REVIEW
  APPROVED
  ACTIVE
  NOT_INTERESTED
  UNQUALIFIED
  DO_NOT_CONTACT
}

enum LeadSource {
  DAT
  TRUCKSTOP
  REFERRAL
  COLD_OUTREACH
  INBOUND
  EVENT
  SOCIAL
  OTHER
}

enum RecruitmentActivityType {
  NOTE
  CALL
  EMAIL
  SMS
  STAGE_CHANGE
  INVITATION_SENT
  CONVERTED
}

model CarrierProspect {
  id                  String   @id @default(cuid())
  companyName         String
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  dotNumber           String?
  mcNumber            String?
  equipmentSummary    String?
  operatingStates     String?  // free-form list, e.g. "IN, IL, OH"
  recruitmentStage    RecruitmentStage @default(NEW_LEAD)
  leadSource          LeadSource       @default(OTHER)
  referralSource      String?
  assignedRecruiterId String?
  convertedCarrierId  String?  @unique   // set once on conversion
  lastContactAt       DateTime?
  nextFollowUpAt      DateTime?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  activities          CarrierRecruitingActivity[]
  tasks               RecruitingTask[]
  @@index([recruitmentStage])
  @@index([assignedRecruiterId])
  @@index([dotNumber])
  @@index([mcNumber])
}

/** Append-only recruiting activity timeline. */
model CarrierRecruitingActivity {
  id             String   @id @default(cuid())
  prospectId     String
  prospect       CarrierProspect @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  activityType   RecruitmentActivityType
  notes          String?
  performedById  String
  occurredAt     DateTime @default(now())
  nextFollowUpAt DateTime?
  @@index([prospectId, occurredAt])
}

model RecruitingTask {
  id           String   @id @default(cuid())
  prospectId   String?
  prospect     CarrierProspect? @relation(fields: [prospectId], references: [id], onDelete: SetNull)
  title        String
  dueAt        DateTime?
  assignedToId String?
  completedAt  DateTime?
  createdById  String
  createdAt    DateTime @default(now())
  @@index([assignedToId, completedAt])
  @@index([dueAt])
}

// ============================================================================
// Dispatcher-to-carrier authorization. A dispatcher (or dispatch office) only
// ever sees carriers that have EXPLICITLY granted access. Access is per-carrier,
// carries a permission set, and is resolved server-side on every dispatcher
// route. Dispatcher access NEVER piggybacks on admin permissions.
//
// Permissions (stored as a string array): VIEW_LOADS, RESPOND_TO_OFFERS,
// UPDATE_LOAD_STATUS, UPLOAD_DOCUMENTS, VIEW_SETTLEMENT_STATUS, MANAGE_DRIVERS,
// VIEW_CARRIER_PROFILE. Deliberately NO payment-routing or compliance-approval
// permission exists in this set.
// ============================================================================

enum DispatcherAccessStatus {
  PENDING
  ACTIVE
  REVOKED
  EXPIRED
}

model DispatcherCarrierAccess {
  id             String   @id @default(cuid())
  dispatcherId   String   // User.id of the dispatcher
  carrierId      String
  carrier        Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  status         DispatcherAccessStatus @default(PENDING)
  permissions    String[] // subset of the permission vocabulary above
  grantedById    String?  // who granted (carrier owner or admin acting for them)
  grantedAt      DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@unique([dispatcherId, carrierId])
  @@index([dispatcherId, status])
  @@index([carrierId, status])
}

// ============================================================================
// Shipper quote request — dormant-safe request-for-contact. While
// directShipperQuoting is disabled, a shipper's quote request lands here as a
// lead (PENDING_CONTACT) rather than a binding broker quote or a booked load.
// ============================================================================

enum ShipperQuoteRequestStatus {
  PENDING_CONTACT
  CONTACTED
  QUOTED
  CONVERTED
  CLOSED
}

model ShipperQuoteRequest {
  id               String   @id @default(cuid())
  shipperUserId    String
  originCity       String?
  originState      String?
  destinationCity  String?
  destinationState String?
  equipmentType    String?
  commodity        String?
  weightLbs        Int?
  palletCount      Int?
  pickupDate       String?
  deliveryDate     String?
  notes            String?
  status           ShipperQuoteRequestStatus @default(PENDING_CONTACT)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([shipperUserId, status])
}

// ============================================================================
// Launch waitlist — VASRUE Digital Media, 29 October 2026.
// Carl's waitlist work order §4. Signups from the public coming-soon page,
// kept for the launch-day email. Additive: one new table and one new enum;
// no existing model, enum or migration is touched.
// ============================================================================

enum WaitlistAudience {
  CUSTOMER
  WORKER
}

model WaitlistSignup {
  id        String           @id @default(cuid())
  email     String
  audience  WaitlistAudience // CUSTOMER | WORKER
  zipCode   String?
  interests String[]
  hasTruck  Boolean?
  firstName String?
  source    String? // UTM / referrer
  createdAt DateTime         @default(now())

  @@unique([email, audience]) // one email may join BOTH lists, once each
  @@index([audience])
  @@index([zipCode])
}
