model LaunchMarket {
  id                    String @id @default(cuid())
  marketCode            String @unique
  name                  String
  state                 String
  countryCode           String @default("US")
  timezone              String @default("America/Indiana/Indianapolis")
  stage                 MarketStage @default(PLANNING)
  // Per-market service controls — a market being ACTIVE does NOT auto-enable
  // every service. Each toggles independently. The freight brokerage control
  // is necessary-but-not-sufficient: it can never override the GLOBAL
  // compliance flags (see lib/compliance/market-brokerage.ts) — brokerage
  // requires global master ON + capability ON + this market flag ON + perm.
  customerBookingEnabled    Boolean @default(false)
  moverRecruitmentEnabled   Boolean @default(false)
  driverRecruitmentEnabled  Boolean @default(false)
  carrierRecruitmentEnabled Boolean @default(false)
  dispatchSupportEnabled    Boolean @default(false)
  freightBrokerageEnabled   Boolean @default(false)
  // Legacy staged-activation flags retained for back-compat with existing
  // route checks; the six controls above are the spec's canonical set.
  publicBookingEnabled     Boolean @default(false)
  workerRecruitingEnabled  Boolean @default(false)
  freightEnabled           Boolean @default(false)
  centerLat             Decimal? @db.Decimal(9,6)
  centerLng             Decimal? @db.Decimal(9,6)
  defaultRadiusMiles    Int?
  targetPropertyManagers Int @default(25)
  targetApartments       Int @default(20)
  targetStorage          Int @default(15)
  targetMovingCompanies  Int @default(15)
  targetRetailers        Int @default(20)
  targetShippers         Int @default(20)
  signedPilotPartners    Int @default(0)
  forecastedJobs         Int @default(0)
  activeMovers           Int @default(0)
  activeBoxTruckDrivers  Int @default(0)
  activeSemiDrivers      Int @default(0)
  fillRate               Decimal @default(0) @db.Decimal(5,2)
  firstAcceptanceMinutes Decimal @default(0) @db.Decimal(7,2)
  noShowRate             Decimal @default(0) @db.Decimal(5,2)
  repeatCustomerRate     Decimal @default(0) @db.Decimal(5,2)
  expansionReady         Boolean @default(false)
  zipCodes               String[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  territories    Territory[]
  jobs           Job[]
  originRoutes   CarrierRoute[] @relation("RouteOrigin")
  destRoutes     CarrierRoute[] @relation("RouteDestination")
  workerMarkets  WorkerMarket[]
  primaryForWorkers WorkerProfile[] @relation("PrimaryMarket")
  partnerMarkets PartnerMarket[]
  pricingRules   MarketPricingRule[]
  adminAssignments AdminAssignment[]
  accessorialPrices AccessorialMarketPrice[]
  changeLogs        MarketChangeLog[]
  carriers          Carrier[]
  @@index([state, stage])
}

/**
