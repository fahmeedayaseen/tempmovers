generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MOVER
  DRIVER
  ADMIN
  SUPPORT
  // Phase: accessorial engine — privileged roles that may override a
  // configured price band with a required reason + audit entry. Normal
  // ADMIN stays constrained to [minimumPrice, maximumPrice].
  FINANCE_ADMIN
  SUPER_ADMIN
  // Carrier company account (freight carrier org — distinct from an individual
  // DRIVER). A carrier user manages the Carrier entity, its documents, and
  // equipment. Recruitment is allowed even while freight brokerage is disabled.
  CARRIER
  RECRUITER
  DISPATCHER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
  PROPERTY_MANAGER
  MOVING_COMPANY
}

enum WorkerType {
  MOVER
  BOX_TRUCK_DRIVER
  SEMI_DRIVER
}

enum VehicleType {
  BOX_TRUCK
  SEMI_TRACTOR
  SEMI_TRACTOR_TRAILER
  CARGO_VAN
  OTHER
}

// HOURLY is legacy/exception-path only — see the pricingModel comment on
// CarrierRoute. New box-truck and semi loads default to FLAT_RATE.
enum FreightPricingModel {
  HOURLY
  FLAT_RATE
}

enum FeeModel {
  ADD_TO_CUSTOMER
  DEDUCT_FROM_PROVIDER
}

// Distinguishes what's actually being booked, not just inferred from
// equipmentType — this is what lets the API enforce "HOURLY pricing is
// only valid for CUSTOMER_SUPPLIED_TRUCK_DRIVER_ONLY", closing a gap
// where a poster could otherwise just pass pricingModel: "HOURLY" for a
// normal owner-operator load with no actual verification.
enum FreightServiceType {
  OWNER_OPERATOR_BOX_TRUCK
  OWNER_OPERATOR_SEMI
  CUSTOMER_SUPPLIED_TRUCK_DRIVER_ONLY
}

// Finer-grained equipment taxonomy for external load-board matching/filtering.
// Deliberately separate from VehicleType — that enum drives fee calculation
// in lib/pricing.ts and touching it risks breaking working pricing logic.
// This is purely descriptive/additive.
enum EquipmentType {
  CARGO_VAN
  SPRINTER_VAN
  STRAIGHT_TRUCK
  BOX_TRUCK_16
  BOX_TRUCK_20
  BOX_TRUCK_24
  BOX_TRUCK_26
  BOX_TRUCK_LIFTGATE
  DRY_VAN_53
  REEFER
  FLATBED
  POWER_ONLY
}

enum LoadBoardProvider {
  INTERNAL
  TRUCKSTOP
  DAT
  LOADBOARD_123
  UBER_FREIGHT
  DIRECT_FREIGHT
}

enum ExternalSyncStatus {
  NOT_SYNCED
  SYNCED
  SYNC_FAILED
  STALE
  // Load transcribed by a dispatcher from an external board (DAT/Truckstop)
  // rather than API-synced. Distinct from NOT_SYNCED: it is intentionally
  // manual and is not awaiting automated sync.
  MANUAL_IMPORT
}

enum JobType {
  RESIDENTIAL_MOVE
  COMMERCIAL_MOVE
  LOADING
  UNLOADING
  LABOR_ONLY
  FURNITURE_DELIVERY
  STORAGE_MOVE
  BOX_TRUCK_ROUTE
  SEMI_ROUTE
  FREIGHT_ASSISTANCE
}

enum JobStatus {
  DRAFT
  POSTED
  MATCHING
  PARTIALLY_FILLED
  CONFIRMED
  IN_PROGRESS
  REVIEW_PENDING
  COMPLETED
  CANCELED
  DISPUTED
}

enum AssignmentStatus {
  INVITED
  APPLIED
  ACCEPTED
  DECLINED
  CHECKED_IN
  CHECKED_OUT
  APPROVED
  CANCELED
  NO_SHOW
}

/** The four customer posting modes for a moving job — freight's
 *  equivalent concept is expressed through the existing RouteVisibility
 *  enum plus CarrierRouteInvitation, rather than a second, parallel
 *  enum, since freight already had a working visibility/invitation
 *  mechanism this round is extending, not replacing. */
enum JobPostingMode {
  OPEN_MARKETPLACE
  PREFERRED_NETWORK_FIRST
  INVITE_SPECIFIC_WORKERS
  PRIVATE_INVITATION_ONLY
}

enum PaymentStatus {
  REQUIRES_PAYMENT_METHOD
  PROCESSING
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
  CANCELED
  DISPUTED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PROCESSING
  TRANSFERRED
  PAID_OUT
  OFFSET
  FAILED
  HELD
  REVERSED
}

/** Status of the customer's tip payment itself — separate from
 *  TipAllocation's status, which tracks each worker's share being
 *  transferred out and reuses PayoutStatus for that, since transferring
 *  a tip allocation to a worker is mechanically the same operation as
 *  any other payout. */
enum TipStatus {
  PROCESSING
  SUCCEEDED
  /** Payment was captured, but the worker split/allocation could not be
   *  completed (e.g. the job's approved-assignment eligibility changed
   *  between charge and webhook, or a database error during allocation
   *  creation). Money was collected; it has NOT reached any worker yet.
   *  Recoverable via POST /api/admin/tips/[tipId]/retry-allocation. */
  PAID_UNALLOCATED
  FAILED
}

enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

enum SubscriptionPlan {
  MOVER
  DRIVER_BASIC
  OWNER_OPERATOR_PRO
  FLEET
}

enum DriverFeeModel {
  NONE
  HOURLY
  PERCENTAGE_CAPPED
}



enum PartnerType {
  PROPERTY_MANAGER
  APARTMENT_COMMUNITY
  STORAGE_FACILITY
  MOVING_COMPANY
  RETAILER
  RESTORATION_COMPANY
  FINAL_MILE_PROVIDER
  WAREHOUSE
  SHIPPER
}

enum BonusRecipientKind {
  CUSTOMER
  MOVER
  DRIVER
  PARTNER
}

enum BonusType {
  CUSTOMER_FIRST_BOOKING_CREDIT
  MOVER_FIRST_JOB_BONUS
  THREE_FIVE_STAR_JOBS_BONUS
  MOVER_REFERRAL_BONUS
  DRIVER_REFERRAL_BONUS
  PARTNER_REFERRAL_CREDIT
  FIRST_ROUTE_FEE_WAIVER
  FOUNDING_MEMBER
}

enum BonusStatus {
  PENDING
  EARNED
  APPROVED
  PAID
  VOIDED
}

enum MarketStage {
  PLANNING
  CARRIER_RECRUITMENT
  COMING_SOON
  SOFT_LAUNCH
  ACTIVE
  PAUSED
  CLOSED
}

enum RouteVisibility {
  PUBLIC_PREVIEW
  VERIFIED_CARRIERS_ONLY
  PREFERRED_NETWORK
  PRIVATE_CONFIDENTIAL
  INTERNAL_DRAFT
}

enum LoadStatus {
  OPEN
  OFFER_RECEIVED
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  POD_UPLOADED
  SETTLED
  CANCELED
}

enum UrgentFeeMode {
  HOURLY_FEE
  PERCENT_PREMIUM
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  passwordHash  String?
  firstName     String
  lastName      String
  phone         String?
  role          UserRole
  status        AccountStatus @default(PENDING)
  termsAcceptedAt DateTime?
  phoneVerifiedAt DateTime?
  smsOptOutAt     DateTime?
  emailSuppressedAt  DateTime?
  emailSuppressedReason String?
  marketingConsent Boolean @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  requestedRefunds PaymentRefund[]

  customerProfile CustomerProfile?
  workerProfile   WorkerProfile?
  adminProfile    AdminProfile?
  notifications   Notification[]
  auditLogs       AuditLog[] @relation("ActorAuditLogs")
  bonusAwards     BonusAward[]
  bonusAwardsApproved BonusAward[] @relation("BonusApprover")
  partnerMemberships PartnerMember[]
  postedLoads     CarrierRoute[] @relation("PostedLoads")
  sessions        Session[]
  adminAssignments AdminAssignment[]
  carrier         Carrier?
  consents        UserConsent[]
  invitationTemplates InvitationTemplate[]
  favoriteWorkers FavoriteWorker[]
  savedSearches   SavedSearch[]
  portfolioReports PortfolioReport[]
}

model CustomerProfile {
  id               String       @id @default(cuid())
  userId           String       @unique
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type             CustomerType @default(INDIVIDUAL)
  companyName      String?
  stripeCustomerId String?      @unique
  defaultAddressId String?
  addresses        Address[]
  jobs             Job[]
  partnerOrganizations PartnerOrganization[]
  reviews          Review[]
  tips             Tip[]
}

model WorkerProfile {
  id                       String             @id @default(cuid())
  userId                   String             @unique
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerType               WorkerType
  bio                      String?
  hourlyEarningsCents      Int                @default(3000)
  serviceRadiusMiles       Int                @default(30)
  homeLatitude             Decimal?           @db.Decimal(10, 7)
  homeLongitude            Decimal?           @db.Decimal(10, 7)
  homeZip                   String?
  acceptingJobs            Boolean            @default(false)
  completedJobs            Int                @default(0)
  firstCompletedJobAt      DateTime?
  subscriptionWaivedUntilFirstJob Boolean      @default(true)
  subscriptionActivatedAt  DateTime?
  backgroundCheckStatus    String              @default("PENDING")
  identityVerification     String              @default("PENDING")
  stripeAccountId          String?             @unique
  stripeChargesEnabled     Boolean             @default(false)
  stripePayoutsEnabled     Boolean             @default(false)
  // Separate from stripeAccountId: that's the worker's Connect account for
  // RECEIVING payouts. This is a plain Stripe Customer object for the
  // worker being CHARGED their own membership fee — two different Stripe
  // object types serving opposite money directions for the same person.
  stripeCustomerId         String?             @unique
  subscriptionStatus       SubscriptionStatus  @default(INCOMPLETE)
  subscriptionPlan         SubscriptionPlan?
  stripeSubscriptionId     String?             @unique
  fleetVehicleAllowance    Int                 @default(1)
  subscriptionCurrentEnd   DateTime?
  availability             Availability[]
  skills                   WorkerSkill[]
  certifications           Certification[]
  languages                WorkerLanguage[]
  favoritedBy              FavoriteWorker[]
  portfolioMedia           PortfolioMedia[]
  assignments              Assignment[]
  vehicles                 Vehicle[]
  payouts                  Payout[]
  tipAllocations           TipAllocation[]
  reviewsReceived          Review[]            @relation("WorkerReviews")
  // Recalculated by lib/reviews.ts on every review submission/moderation
  // action — never written directly anywhere else, so these can't drift
  // from what PUBLISHED reviews actually say.
  ratingAverage            Float               @default(0)
  ratingCount              Int                 @default(0)
  fiveStarReviewCount      Int                 @default(0)
  bonusAwards              BonusAward[]
  preferredNetworks        PreferredWorker[]
  assignedLoads            CarrierRoute[]
  settlements              Settlement[]
  workerMarkets            WorkerMarket[]
  workerTerritories        WorkerTerritory[]
  routeInvitations         CarrierRouteInvitation[]
  documents                WorkerDocument[]
  backgroundChecks         BackgroundCheck[]
  screeningCharges         ScreeningCharge[]
  compliance               WorkerCompliance?
  insurancePolicies        InsurancePolicy[]
  vehicleVerificationStatus    String @default("PENDING")
  insuranceVerificationStatus  String @default("PENDING")
  dotMcVerificationStatus      String @default("NOT_REQUIRED")
  carrierVerification          CarrierVerification?
  stripeConnectOnboarded       Boolean @default(false)

  // Holistic onboarding/review lifecycle — distinct from the granular
  // per-document strings above (those track individual checks; these track
  // the overall gate that actually controls load access). Named distinctly
  // from User.status (AccountStatus) which is a platform-wide account
  // state, not a worker-specific operational one — a worker can be a fine
  // User account (not suspended) while still PENDING here.
  onboardingStatus       OnboardingStatus @default(INCOMPLETE)
  overallVerificationStatus WorkerVerificationStatus @default(PENDING)
  operationalStatus      WorkerOperationalStatus @default(PENDING)

  legalName       String?
  displayName     String?
  dateOfBirth     DateTime?
  profilePhotoUrl String?

  businessName String?
  dba          String?
  mcNumber     String?
  einLast4     String?
  // USDOT number lives on CarrierVerification (the FMCSA record), not
  // duplicated here — that's the authoritative source for it.

  primaryMarketId String?
  primaryMarket   LaunchMarket? @relation("PrimaryMarket", fields: [primaryMarketId], references: [id], onDelete: SetNull)

  // Who referred this worker, if anyone — this is what lets a mover/driver
  // referral bonus fire once the REFERRED worker hits their qualifying
  // threshold. Nothing populated this before; it's set at registration
  // when a referral code is present (see POST /api/auth/register).
  referredByWorkerId String?
  referredByWorker   WorkerProfile?  @relation("WorkerReferrals", fields: [referredByWorkerId], references: [id], onDelete: SetNull)
  referredWorkers     WorkerProfile[] @relation("WorkerReferrals")

  submittedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
}

enum OnboardingStatus {
  INCOMPLETE
  IN_PROGRESS
  SUBMITTED
  COMPLETE
}

enum WorkerVerificationStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  SUSPENDED
}

enum WorkerOperationalStatus {
  PENDING
  ACTIVE
  RESTRICTED
  SUSPENDED
  CLOSED
}

model AdminProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title  String?
}

model Address {
  id          String           @id @default(cuid())
  customerId  String?
  customer    CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label       String?
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  country     String           @default("US")
  latitude    Decimal?         @db.Decimal(10, 7)
  longitude   Decimal?         @db.Decimal(10, 7)
  placeId     String?
  geocodedAt  DateTime?
  jobs        Job[]
}

model Availability {
  id          String        @id @default(cuid())
  workerId    String
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  isAvailable Boolean       @default(true)
  @@index([workerId, startsAt, endsAt])
}

model Skill {
  id          String        @id @default(cuid())
  name        String        @unique
  workerLinks WorkerSkill[]
  jobLinks    JobSkill[]
}

model WorkerSkill {
  workerId String
  skillId  String
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  skill    Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([workerId, skillId])
}

model JobSkill {
  jobId   String
  skillId String
  job     Job   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  @@id([jobId, skillId])
}

// FMCSA baseline check only — NOT complete carrier onboarding by itself.
// Insurance, W-9, Stripe identity, and vehicle documents are separate,
// existing verification fields on WorkerProfile/Vehicle. This model exists
// so a real FMCSA response (once FMCSA_WEB_KEY is configured — see
// lib/fmcsa.ts) has somewhere durable to land, distinct from the simple
// dotMcVerificationStatus string gate that already exists.
// Private loads are hidden from every board (see PUBLIC_LOAD_SELECT and
// GET /api/driver/loads), but hiding isn't the same as granting access —
// this is the actual invite/accept/decline/expire workflow that makes
// PRIVATE_CONFIDENTIAL visibility mean something.
model CarrierRouteInvitation {
  id             String   @id @default(cuid())
  carrierRouteId String
  carrierRoute   CarrierRoute @relation(fields: [carrierRouteId], references: [id], onDelete: Cascade)

  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  status       RouteInvitationStatus @default(PENDING)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  respondedAt  DateTime?

  @@unique([carrierRouteId, workerId])
  @@index([workerId, status])
}

enum RouteInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

// Phase 4 (Freight Invitations) — reusable, owner-scoped message
// templates for freight load invitations. Deliberately freight-only
// for now (no jobId/loadId FK, no "type" discriminator beyond the
// fact every current caller is the load-invitation flow) rather than
// a speculative generic "message template" system nothing else uses
// yet — see PHASE-4-FREIGHT-INVITATIONS.md.
model InvitationTemplate {
  id          String   @id @default(cuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name        String
  subject     String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerUserId])
}

// Phase 5 (Profiles, Reputation & Discovery). A professional
// certification held by a worker — deliberately distinct from Skill (a
// free-form capability tag): a certification has an issuer and can
// expire, and carries its own verification state so a business can
// tell an admin-verified cert from a self-asserted one. status mirrors
// the string-status convention used elsewhere on WorkerProfile
// (identityVerification etc.) rather than a new enum, for consistency.
model Certification {
  id         String    @id @default(cuid())
  workerId   String
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  name       String
  issuer     String?
  issuedAt   DateTime?
  expiresAt  DateTime?
  status     String    @default("SELF_REPORTED") // SELF_REPORTED | VERIFIED | REJECTED
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([workerId])
}

// Phase 5. A language a worker can work in, with a coarse proficiency.
// A join model (not a String[]) specifically so discovery can filter
// "workers who speak X" with an indexed query. languageCode is an
// ISO-639-1 code (validated at the API layer, not in the DB).
model WorkerLanguage {
  workerId     String
  worker       WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  languageCode String
  proficiency  String        @default("CONVERSATIONAL") // BASIC | CONVERSATIONAL | FLUENT | NATIVE

  @@id([workerId, languageCode])
  @@index([languageCode])
}

// Phase 5. A customer's personal bookmark of a worker. Intentionally
// separate from PreferredWorker (Phase 2): PreferredWorker is
// partner-organization-scoped and priority-ranked (an operational
// roster shared by a partner org's team); a FavoriteWorker is a single
// user's private star, with no priority and no partner scope. Keeping
// them separate avoids overloading the Phase 2 roster semantics.
model FavoriteWorker {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerId   String
  worker     WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, workerId])
  @@index([userId, createdAt])
}

// Phase 5. A saved set of directory search criteria. Stores the
// FILTER PARAMS as JSON, never a cached result set — re-running a
// saved search replays the params against the live worker-directory
// query, so results are always current. params shape is validated by
// lib/discovery/saved-search.ts against the same schema the directory
// route uses, so a saved search can't smuggle in fields the directory
// doesn't support.
model SavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  params    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

// ===== Phase 5.5 — Portfolio Media & Moderation =====
// Human moderation is the publication gate: only APPROVED, non-deleted
// media is ever public. Private storage keys live here but are NEVER in
// a public response (see lib/portfolio/public-select.ts).

enum PortfolioModerationStatus {
  DRAFT
  UPLOADING
  PENDING
  APPROVED
  REJECTED
  REMOVED
}

// Phase 5.5B: tracks the image-processing pipeline independently of
// moderation. Approval is gated on this reaching PROCESSED (see
// lib/portfolio/state.ts canApprove). NOT_REQUIRED is used when the
// processing feature flag is off, so 5.5A-style flows (no processing)
// can still be approved.
enum PortfolioProcessingStatus {
  NOT_REQUIRED
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum PortfolioMediaType {
  IMAGE
}

enum PortfolioReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum PortfolioReportReason {
  INAPPROPRIATE
  SPAM
  COPYRIGHT
  PRIVACY
  MISLEADING
  OTHER
}

model PortfolioMedia {
  id           String   @id @default(cuid())
  workerId     String
  worker       WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type         PortfolioMediaType @default(IMAGE)
  title        String?
  description  String?
  categoryId   String?
  category     PortfolioCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Private storage identifiers — never exposed in a public response.
  storageKey   String  @unique
  thumbnailKey String?
  publicAssetId String? // optional CDN id, not a raw bucket URL

  mimeType     String
  fileSize     Int
  width        Int?
  height       Int?

  status          PortfolioModerationStatus @default(DRAFT)
  processingStatus PortfolioProcessingStatus @default(NOT_REQUIRED)
  processingError String?  // internal — last processing failure reason
  // Phase 5.5B stale-worker recovery: populated when a worker claims a
  // job, so a recovery task can detect PROCESSING rows whose worker died
  // and retry or fail them. processingAttempts bounds infinite retries.
  processingStartedAt     DateTime?
  processedAt             DateTime?
  processingAttempts      Int      @default(0)
  lastProcessingAttemptAt DateTime?
  rejectionReason String?  // worker-visible
  moderationNote  String?  // internal only, never public

  isPrimary    Boolean @default(false)
  displayOrder Int     @default(0)

  uploadedAt   DateTime?
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  rejectedAt   DateTime?
  rejectedById String?
  removedAt    DateTime?
  removedById  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  reports      PortfolioReport[]

  @@index([workerId, status, displayOrder])
  @@index([status, submittedAt])
  @@index([categoryId, status])
}

model PortfolioCategory {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  description  String?
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  media        PortfolioMedia[]
}

model PortfolioReport {
  id             String   @id @default(cuid())
  mediaId        String
  media          PortfolioMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  reporterUserId String
  reporter       User     @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  reason         PortfolioReportReason
  details        String?
  status         PortfolioReportStatus @default(OPEN)
  reviewedById   String?
  resolutionNote String?
  createdAt      DateTime @default(now())
  reviewedAt     DateTime?

  @@index([mediaId, status])
  @@index([status, createdAt])
}

// Structured document storage — replaces ad-hoc URL fields with a real,
// per-document review trail (who submitted it, who reviewed it, when,
// expiry, and why if rejected). File upload/storage itself still needs a
// private object-storage provider with signed URLs (see README) — this
// model is ready to receive that fileUrl once one exists.
model WorkerDocument {
  id       String @id @default(cuid())
  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  type        WorkerDocumentType
  fileUrl     String
  status      DocumentReviewStatus @default(PENDING)
  expiresAt   DateTime?
  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  reason      String?

  @@index([workerId, type, status])
}

enum WorkerDocumentType {
  DRIVERS_LICENSE
  CDL
  MEDICAL_CARD
  VEHICLE_REGISTRATION
  VEHICLE_PHOTO
  CERTIFICATE_OF_INSURANCE
  W9
  OPERATING_AUTHORITY
  PROFILE_PHOTO
  OTHER
}

enum DocumentReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// Versioned consent trail — User.termsAcceptedAt/marketingConsent (added
// earlier) capture "did they accept," this captures "accept what version,
// from where" for actual legal defensibility, and supports more consent
// types than just terms/marketing without more User columns.
model UserConsent {
  id         String @id @default(cuid())
  userId     String
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       ConsentType
  version    String
  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  @@index([userId, type])
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING
}

// Checkr background check tracking. Status/result stay generic strings
// (not narrow enums) since Checkr's own status vocabulary can add values
// over time — pinning to a Prisma enum would require a migration every
// time Checkr changes their API rather than just accepting the new string.
model BackgroundCheck {
  id           String   @id @default(cuid())
  workerId     String
  worker       WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  provider     String   @default("CHECKR")
  // Required, not optional: the whole point of this schema revision is that
  // every invitation is now tied to a real Checkr candidate_id, created (or
  // reused) BEFORE the invitation — see lib/screening/start-checkr.ts. The
  // old direct candidate_email invitation call never produced a candidate
  // ID to store, so this had to stay nullable before; it doesn't anymore.
  candidateId  String
  invitationId String?  @unique
  reportId     String?  @unique
  invitationUrl String?
  packageSlug  String
  status       String
  result       String?
  completedAt  DateTime?
  rawResponse  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  screeningCharge ScreeningCharge?
  @@index([workerId, status])
  @@index([candidateId])
}

// Applicant-paid, one-time screening checkout — separate from
// WorkerProfile.subscriptionPlan (the recurring membership). Afterpay is a
// Stripe Checkout payment method for THIS charge only; it must never be
// offered on the recurring subscription checkout in
// app/api/stripe/worker-subscription/route.ts, since Afterpay doesn't
// support Checkout subscription mode at all.
model ScreeningCharge {
  id                String   @id @default(cuid())
  workerId          String
  worker            WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  backgroundCheckId String?  @unique
  backgroundCheck   BackgroundCheck? @relation(fields: [backgroundCheckId], references: [id], onDelete: SetNull)

  packageSlug            String
  currency               String  @default("usd")
  baseAmountCents        Int
  passThroughAmountCents Int     @default(0)
  totalAmountCents       Int
  paymentProvider        ScreeningPaymentProvider?
  status                 ScreeningChargeStatus @default(QUOTED)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripePaymentMethodId   String?
  stripePaymentMethodType String?
  stripeWalletType        String?
  stripeChargeId          String? @unique
  stripeRefundId          String? @unique

  feeDisclosureVersion     String
  feeDisclosureAcceptedAt  DateTime?
  fcraAuthorizationAt      DateTime?
  paidAt                   DateTime?
  refundedAt               DateTime?
  screeningOrderedAt       DateTime?

  // Sponsorship / admin override trail — set together whenever
  // paymentProvider becomes PLATFORM_SPONSORED, per section 12 of the
  // handoff ("records reason/approver").
  sponsoredById     String?
  sponsorshipReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workerId, status])
}

enum ScreeningPaymentProvider {
  STRIPE_CARD
  APPLE_PAY
  GOOGLE_PAY
  CASH_APP_PAY
  LINK
  AFTERPAY_CLEARPAY
  KLARNA
  AFFIRM
  PLATFORM_SPONSORED
  OTHER_STRIPE
}

// Webhook replay/idempotency ledger for Checkr events — the equivalent of
// ProcessedStripeEvent, which already exists for the Stripe webhook. Before
// this, the Checkr webhook had no event-ID deduplication at all, so a
// redelivered event could reprocess (and re-audit-log) the same update
// indefinitely.
// Durable record of a supplemental detention charge — previously the
// PaymentIntent ID only ever landed in the audit log, with no queryable
// payment status and no link from a paid detention charge to the driver's
// payout/ledger. One row per charge attempt (a failed off-session
// confirmation gets its own row on retry, not an overwrite).
// Closes P1-02: a stable idempotency key based only on job/load ID could
// return an old, now-canceled PaymentIntent forever once that intent
// expired or was explicitly canceled — Stripe's idempotency guarantee
// means the SAME key always returns the SAME (stale) object. Keying by
// attempt number instead means a genuine reauthorization gets a fresh
// idempotency key, while retrying the SAME attempt (e.g. a network
// failure before we got the response) still correctly reuses it.
// The authoritative receipt record — previously a "receipt" was just
// notification text sent immediately from the capture route using our
// own computed finalTotalCents, with nothing persisted and no link to
// what Stripe actually confirmed (amount_received can differ from what
// we requested, e.g. on a partial capture; the charge ID, payment
// method summary, and hosted receipt URL didn't exist anywhere). This
// is populated from the webhook's payment_intent.succeeded handler,
// after Stripe confirms — not optimistically from the capture route,
// which only knows what it asked for, not what was actually settled.
model PaymentTransaction {
  id                      String   @id @default(cuid())
  jobId                   String?
  job                     Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  loadId                  String?
  load                    CarrierRoute? @relation(fields: [loadId], references: [id], onDelete: Cascade)
  stripePaymentIntentId   String
  stripeChargeId          String   @unique
  amountReceivedCents     Int
  currency                String   @default("usd")
  paymentMethodBrand      String?
  paymentMethodLast4      String?
  receiptUrl              String?
  refundedAmountCents     Int      @default(0)
  refunds                 PaymentRefund[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([jobId])
  @@index([loadId])
}

// P1-05: the missing creation half of the refund lifecycle. Previously
// only reconciliation existed (the charge.refunded webhook updating
// cumulative totals) — there was no authorized, auditable operation for
// an admin to actually INITIATE a refund, no per-refund history (only a
// cumulative total on PaymentTransaction), and no protection against two
// concurrent refund requests over-claiming the same refundable balance.
model PaymentRefund {
  id                   String        @id @default(cuid())
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  stripeRefundId       String?       @unique
  idempotencyKey       String        @unique
  amountCents          Int
  currency             String        @default("usd")
  status               RefundStatus  @default(PROCESSING)
  reason               String
  failureCode          String?
  failureMessage       String?

  requestedByUserId    String
  requestedByUser      User          @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)

  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  succeededAt          DateTime?
  failedAt             DateTime?

  @@index([paymentTransactionId, createdAt])
  @@index([requestedByUserId, createdAt])
}

enum RefundStatus {
  PROCESSING
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model PaymentAttempt {
  id                    String   @id @default(cuid())
  jobId                 String?
  job                   Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  loadId                String?
  load                  CarrierRoute? @relation(fields: [loadId], references: [id], onDelete: Cascade)
  attemptNumber         Int
  idempotencyKey        String   @unique
  stripePaymentIntentId String?  @unique
  // Tracks THIS ROW's own claim/creation lifecycle — separate from
  // paymentStatus, which tracks the actual Stripe PaymentIntent state.
  // PROCESSING means "claimed, Stripe call not yet confirmed"; a request
  // that dies between claiming the row and hearing back from Stripe
  // leaves this in PROCESSING, which is what identifies it as
  // retryable/investigable rather than silently ambiguous.
  operationStatus       PaymentAttemptOperationStatus @default(PROCESSING)
  paymentStatus         PaymentStatus @default(REQUIRES_PAYMENT_METHOD)
  authorizedAt          DateTime?
  canceledAt            DateTime?
  cancelReason          String?
  failureReason         String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([jobId, attemptNumber])
  @@unique([loadId, attemptNumber])
  @@index([jobId])
  @@index([loadId])
}

enum PaymentAttemptOperationStatus {
  PROCESSING
  CREATED
  FAILED
  CANCELED
}

model DetentionCharge {
  id                    String   @id @default(cuid())
  loadId                String
  load                  CarrierRoute @relation(fields: [loadId], references: [id], onDelete: Cascade)
  amountCents           Int
  stripePaymentIntentId String   @unique
  paymentStatus         PaymentStatus @default(REQUIRES_PAYMENT_METHOD)
  approvedById          String
  approvedAt            DateTime
  paidAt                DateTime?
  failureReason         String?
  // Genuinely means "paid out to the driver" — set when the settlement
  // that includes this charge reaches TRANSFERRED, not at settlement
  // generation. settlementLine (below) is what actually tracks "claimed
  // by a pending settlement" now, via its unique detentionChargeId.
  includedInPayoutAt    DateTime?
  settlementLine        SettlementDetentionLine?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([loadId, paymentStatus])
}

// Immutable snapshot — preserves the exact amount included in a
// settlement even if the source DetentionCharge is later edited. The
// unique constraint on detentionChargeId is the actual eligibility
// mechanism now: a charge can belong to at most one settlement line,
// ever, which is what makes double-settlement of the same charge
// impossible at the database level rather than just application logic.
model SettlementDetentionLine {
  id                String @id @default(cuid())
  settlementId      String
  settlement        Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  detentionChargeId String @unique
  detentionCharge   DetentionCharge @relation(fields: [detentionChargeId], references: [id], onDelete: Restrict)
  loadId            String
  amountCents       Int
  createdAt         DateTime @default(now())

  @@index([settlementId])
}

// Real partner billing — the previous endpoint only summed loads by
// createdAt with no eligibility rule and created nothing durable. An
// invoice is a frozen snapshot at generation time: line amounts here
// never change even if the underlying CarrierRoute's own fields are
// later edited, which is what makes this auditable/disputable.
model PartnerInvoice {
  id                 String   @id @default(cuid())
  partnerOrganizationId String
  partnerOrganization PartnerOrganization @relation(fields: [partnerOrganizationId], references: [id], onDelete: Restrict)
  periodStart        DateTime
  periodEnd          DateTime
  status             PartnerInvoiceStatus @default(DRAFT)
  subtotalCents      Int
  platformFeeCents   Int
  totalCents         Int
  stripeInvoiceId    String?  @unique
  stripeCustomerId   String?
  dueDate            DateTime?
  finalizedAt        DateTime?
  paidAt             DateTime?
  voidedAt           DateTime?
  lines              PartnerInvoiceLine[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([partnerOrganizationId, status])
}

// One immutable row per billed load. The unique constraint on loadId is
// what makes a load billable exactly once — a second invoice generation
// run for an overlapping period can't double-bill a load that's already
// on an earlier invoice.
model PartnerInvoiceLine {
  id                String   @id @default(cuid())
  partnerInvoiceId  String
  partnerInvoice    PartnerInvoice @relation(fields: [partnerInvoiceId], references: [id], onDelete: Cascade)
  loadId            String   @unique
  load              CarrierRoute @relation(fields: [loadId], references: [id], onDelete: Restrict)
  title             String
  deliveredAt       DateTime?
  grossCarrierCents Int
  platformFeeCents  Int
  lineTotalCents    Int
  createdAt         DateTime @default(now())
}

enum PartnerInvoiceStatus {
  DRAFT
  FINALIZED
  SENT
  PAID
  PAST_DUE
  VOID
}

model ProcessedCheckrEvent {
  id            String   @id
  eventType     String
  candidateId   String?
  reportId      String?
  invitationId  String?
  status        CheckrEventProcessingStatus @default(PENDING_RECONCILIATION)
  rawPayload    Json
  receivedAt    DateTime @default(now())
  processedAt   DateTime?
  reconciledAt  DateTime?
  attemptCount  Int      @default(0)
  lastAttemptAt DateTime?
  lastError     String?

  @@index([status, receivedAt])
  @@index([candidateId])
  @@index([reportId])
  @@index([invitationId])
}

enum CheckrEventProcessingStatus {
  PENDING_RECONCILIATION
  PROCESSED
  FAILED
}

enum ScreeningChargeStatus {
  QUOTED
  CHECKOUT_PENDING
  PAID
  SCREENING_ORDERED
  SCREENING_PENDING
  APPROVED
  CONSIDER
  FAILED
  CANCELED
  REFUNDED
  DISPUTED
  WAIVED
}

// Per-credential-track compliance status — distinct from the coarser
// existing WorkerProfile string fields (identityVerification,
// vehicleVerificationStatus, etc.), which stay as the fast-path gate for
// job/load acceptance. This is the fuller, role-aware breakdown the
// opportunity-access policy and admin compliance screens read from.
model WorkerCompliance {
  id       String @id @default(cuid())
  workerId String @unique
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  identityStatus       ComplianceDecision @default(NOT_STARTED)
  backgroundStatus     ComplianceDecision @default(NOT_STARTED)
  licenseStatus        ComplianceDecision @default(NOT_STARTED)
  mvrStatus            ComplianceDecision @default(NOT_STARTED)
  insuranceStatus      ComplianceDecision @default(NOT_STARTED)
  vehicleStatus        ComplianceDecision @default(NOT_STARTED)
  dotStatus            ComplianceDecision @default(NOT_STARTED)
  mcStatus             ComplianceDecision @default(NOT_STARTED)
  cdlStatus            ComplianceDecision @default(NOT_STARTED)
  adminApprovalStatus  ComplianceDecision @default(NOT_STARTED)

  approvedAt        DateTime?
  restrictedAt      DateTime?
  restrictionReason String?
  expiresAt         DateTime?
  updatedAt         DateTime @updatedAt
}

enum ComplianceDecision {
  NOT_STARTED
  IN_PROGRESS
  PENDING_REVIEW
  APPROVED
  RESTRICTED
  SUSPENDED
  EXPIRED
}

// Certificial (or manual/admin-entered) insurance monitoring — separate
// from the simpler insuranceVerificationStatus string already on
// WorkerProfile, which stays as the coarse onboarding-gate flag. This is
// the detailed policy record behind it: limits, carrier, expiry, so a
// lapse can be detected and enforced automatically, not just self-reported
// once at onboarding.
model InsurancePolicy {
  id               String   @id @default(cuid())
  workerId         String
  worker           WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  provider         String   @default("CERTIFICIAL")
  externalPolicyId String?
  policyType       String
  carrierName      String?
  policyNumber     String?
  limitCents       Int?
  effectiveAt      DateTime?
  expiresAt        DateTime?
  status           String
  rawResponse      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([workerId, status])
}

model CarrierVerification {
  id              String   @id @default(cuid())
  workerId        String   @unique
  worker          WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  usdotNumber     String?
  legalName       String?
  operatingStatus String?
  rawResponse     Json?
  decision        CarrierVerificationDecision @default(PENDING)
  verifiedAt      DateTime?
  expiresAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([decision, expiresAt])
}

enum CarrierVerificationDecision {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ============================================================================
// Carrier Onboarding (launch spec phase 3) — the CARRIER COMPANY entity,
// distinct from an individual DRIVER (WorkerProfile). Recruitment is allowed
// while freight brokerage stays disabled; brokerage-related agreements/load
// workflows remain behind the global + market compliance gates.
// ============================================================================

enum CarrierStatus {
  APPLICATION_STARTED   // account created; cannot receive loads
  DOCUMENTS_PENDING     // required docs not all uploaded
  UNDER_REVIEW          // admin compliance review in progress
  APPROVED              // compliance review passed (NOT yet eligible for loads)
  ACTIVE                // currently eligible to receive opportunities
  TEMPORARILY_INACTIVE  // paused by carrier/admin, reversible
  SUSPENDED             // admin action, not eligible
  REJECTED              // application denied
  EXPIRED_DOCUMENTS     // a required doc/insurance lapsed → load-ineligible
}

enum CarrierPaymentPreference {
  DIRECT_DEPOSIT
  FACTORING
  QUICK_PAY
}

model Carrier {
  id                 String   @id @default(cuid())
  // Owning user (role CARRIER). One carrier company per owning user for now.
  ownerUserId        String   @unique
  ownerUser          User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  // Business identity
  legalBusinessName  String
  dbaName            String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  businessAddress    String?
  ein                String?
  dotNumber          String?
  mcNumber           String?
  authorityStatus    String?  // free-form snapshot; authoritative check is CarrierFmcsaCheck
  authorityAgeMonths Int?
  homeTerminal       String?
  operatingRadiusMiles Int?
  numberOfTrucks     Int?     @default(0)

  // Payment: ACH/banking details are NOT stored here — they live with the
  // payment provider (Stripe). We keep only a preference + a provider token
  // reference, never raw bank numbers (spec rule #5).
  paymentPreference  CarrierPaymentPreference @default(DIRECT_DEPOSIT)
  paymentProviderRef String?  // e.g. Stripe connected-account id — NOT bank data
  // Factoring is modeled as its own profile + payment-assignment records
  // (see CarrierFactoringProfile / PaymentAssignment) rather than inline fields,
  // so payment routing has verification, change-control, and audit.

  // Lifecycle
  status             CarrierStatus @default(APPLICATION_STARTED)
  statusReason       String?
  approvedAt         DateTime?
  activatedAt        DateTime?

  // Market association (recruitment market)
  marketId           String?
  market             LaunchMarket? @relation(fields: [marketId], references: [id], onDelete: SetNull)

  documents          CarrierDocument[]
  insurancePolicies  CarrierInsurancePolicy[]
  equipment          CarrierEquipment[]
  lanes              CarrierLane[]
  agreements         CarrierAgreement[]
  fmcsaChecks        CarrierFmcsaCheck[]
  statusEvents       CarrierStatusEvent[]
  factoringProfile   CarrierFactoringProfile?
  paymentAssignments PaymentAssignment[]
  factoringReferrals FactoringReferral[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([dotNumber])
  @@unique([mcNumber])
  @@index([status, marketId])
  notes            CarrierNote[]
  dispatcherAccess DispatcherCarrierAccess[]
}

enum CarrierDocumentType {
  W9
  CERTIFICATE_OF_INSURANCE
  AUTHORITY_LETTER
  CARRIER_AGREEMENT
  OTHER
}

model CarrierDocument {
  id           String   @id @default(cuid())
  carrierId    String
  carrier      Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  type         CarrierDocumentType
  // Object-storage key only — the file lives in S3, not the DB.
  storageKey   String
  fileName     String?
  uploadedById String
  verified     Boolean  @default(false)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  @@index([carrierId, type])
  rejectionReason String?
  supersededById  String?
  supersededAt    DateTime?
}

enum InsuranceType {
  AUTO_LIABILITY
  CARGO
  GENERAL_LIABILITY
}

model CarrierInsurancePolicy {
  id            String   @id @default(cuid())
  carrierId     String
  carrier       Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  type          InsuranceType
  insurerName   String?
  policyNumber  String?
  coverageCents Int?
  effectiveAt   DateTime?
  expiresAt     DateTime?
  // COI document backing this policy, if uploaded.
  documentId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([carrierId, type, expiresAt])
}

model CarrierEquipment {
  id            String   @id @default(cuid())
  carrierId     String
  carrier       Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  equipmentType String   // e.g. VAN, REEFER, FLATBED, BOX_TRUCK
  year          Int?
  make          String?
  unitNumber    String?
  vinLast6      String?
  hasLiftgate   Boolean  @default(false)
  createdAt     DateTime @default(now())
  @@index([carrierId])
}

model CarrierLane {
  id              String  @id @default(cuid())
  carrierId       String
  carrier         Carrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  originState     String?
  originMetro     String?
  destinationState String?
  destinationMetro String?
  createdAt       DateTime @default(now())
  @@index([carrierId])
}

model CarrierAgreement {
  id           String   @id @default(cuid())
  carrierId    String
  carrier      Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  // "DISPATCH" agreements are launch-safe; "BROKER_CARRIER" agreements stay
  // behind the compliance gates (spec rule #6) — creating/activating one is
  // guarded at the route level by assertBrokerageAllowed('brokerCarrierAgreements').
  agreementType String   // DISPATCH | BROKER_CARRIER
  version      String?
  signedAt     DateTime?
  signedByName String?
  documentId   String?
  active       Boolean  @default(false)
  createdAt    DateTime @default(now())
  @@index([carrierId, agreementType])
}

/**
 * FMCSA verification record. Point-in-time snapshot — NOT permanently valid.
 * Stores the verification date + the raw source result so eligibility can be
 * re-checked and staleness detected (spec rule #4).
 */
model CarrierFmcsaCheck {
  id             String   @id @default(cuid())
  carrierId      String
  carrier        Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  dotNumber      String?
  mcNumber       String?
  operatingStatus String? // result from source (e.g. "ACTIVE"/"INACTIVE")
  authorized     Boolean?
  sourceResult   Json?    // raw provider payload
  checkedAt      DateTime @default(now())
  checkError     String?  // set when the lookup failed (rule: handle failures)
  @@index([carrierId, checkedAt])
}

model CarrierStatusEvent {
  id            String   @id @default(cuid())
  carrierId     String
  carrier       Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  fromStatus    CarrierStatus?
  toStatus      CarrierStatus
  reason        String?
  changedById   String
  createdAt     DateTime @default(now())
  @@index([carrierId, createdAt])
}

// ============================================================================
// Factoring foundation (launch-required now; referral portal + live partner
// integrations come later). Bank-account credentials are NEVER stored here —
// only factoring-company routing/remittance instructions and document refs.
// ============================================================================

enum FactoringVerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED        // NOA/document lapsed or was replaced → needs re-verification
}

/**
 * Per-carrier factoring profile. Captures WHETHER the carrier factors and the
 * factoring company's identity/contact + a reference number. Verification is
 * an admin action with a date + verifier. Does NOT hold bank credentials.
 */
model CarrierFactoringProfile {
  id                 String   @id @default(cuid())
  carrierId          String   @unique
  carrier            Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  usesFactoring      Boolean  @default(false)
  factoringCompanyName String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  accountReference   String?  // factoring account/reference number (NOT a bank number)
  // Optional link to a known FactoringPartner (dormant until agreements signed).
  factoringPartnerId String?
  factoringPartner   FactoringPartner? @relation(fields: [factoringPartnerId], references: [id], onDelete: SetNull)

  verificationStatus FactoringVerificationStatus @default(NOT_SUBMITTED)
  verifiedAt         DateTime?
  verifiedById       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@index([verificationStatus])
}

enum FactoringDocumentType {
  NOTICE_OF_ASSIGNMENT
  RELEASE_OF_ASSIGNMENT
  REMITTANCE_INSTRUCTIONS
  OTHER
}

model FactoringDocument {
  id            String   @id @default(cuid())
  carrierId     String
  type          FactoringDocumentType
  storageKey    String   // S3 key only — file not in DB
  fileName      String?
  uploadedById  String
  effectiveAt   DateTime?
  expiresAt     DateTime?      // expiration / replacement tracking
  supersededById String?       // set when replaced by a newer document
  createdAt     DateTime @default(now())
  @@index([carrierId, type, expiresAt])
}

enum PaymentAssignmentStatus {
  PENDING_REVIEW
  ACTIVE
  SUPERSEDED
  REVOKED
}

/**
 * Payment routing under a Notice of Assignment. When an assignment is ACTIVE,
 * carrier payments must follow THESE remittance instructions. A carrier cannot
 * change the destination without admin review + supporting docs + an audit
 * entry — enforced at the route level; every change writes a
 * PaymentRoutingAudit row.
 */
model PaymentAssignment {
  id                 String   @id @default(cuid())
  carrierId          String
  carrier            Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  // Where funds are remitted under the NOA — a factoring company's remittance
  // instructions (payee name, remit-to reference), NOT a bank account number.
  remitToName        String
  remitToReference   String?
  remittanceInstructions String?
  noaDocumentId      String?  // the verified Notice of Assignment backing this
  status             PaymentAssignmentStatus @default(PENDING_REVIEW)
  approvedById       String?
  approvedAt         DateTime?
  effectiveAt        DateTime?
  supersededById     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  audits             PaymentRoutingAudit[]
  @@index([carrierId, status])
}

/**
 * Immutable audit trail for payment-routing changes (who changed remittance to
 * what, with what supporting doc + reason). Append-only.
 */
model PaymentRoutingAudit {
  id                 String   @id @default(cuid())
  paymentAssignmentId String
  paymentAssignment  PaymentAssignment @relation(fields: [paymentAssignmentId], references: [id], onDelete: Cascade)
  action             String   // CREATED | APPROVED | SUPERSEDED | REVOKED | CHANGE_REQUESTED
  previousRemitTo    String?
  newRemitTo         String?
  supportingDocumentId String?
  reason             String?
  changedById        String
  createdAt          DateTime @default(now())
  @@index([paymentAssignmentId, createdAt])
}

enum FactoringPartnerStatus {
  PROSPECT          // no agreement yet
  AGREEMENT_PENDING
  ACTIVE            // signed — referrals may be enabled
  INACTIVE
}

enum FactoringCommissionType {
  NONE
  FLAT
  PERCENTAGE
  PER_FUNDED_LOAD
}

/**
 * A factoring company TempMovers may refer carriers to. DORMANT foundation:
 * referralEnabled defaults false and stays off until an agreement is signed.
 * No hard-coded integration to any specific company — applicationUrl +
 * trackingCode support a generic referral until a partner provides real API
 * docs.
 */
model FactoringPartner {
  id             String   @id @default(cuid())
  companyName    String
  status         FactoringPartnerStatus @default(PROSPECT)
  referralEnabled Boolean @default(false)
  applicationUrl String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  referralTerms  String?
  commissionType FactoringCommissionType @default(NONE)
  commissionAmount Int?   // cents (FLAT/PER_FUNDED_LOAD) or basis points (PERCENTAGE)
  trackingCode   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  referrals      FactoringReferral[]
  factoringProfiles CarrierFactoringProfile[]
  @@index([status, referralEnabled])
}

enum FactoringReferralStatus {
  REQUESTED
  CONSENTED
  SUBMITTED
  CONTACTED
  APPLICATION_STARTED
  APPROVED
  DECLINED
  FUNDED
  CANCELED
}

/**
 * A referral of a carrier to a factoring partner. DORMANT foundation — created
 * now so the data model is stable, but the carrier-facing referral flow and
 * any external submission stay disabled until partner agreements are signed
 * (gated by a feature flag at the route level). consentTimestamp records the
 * carrier's explicit consent before any data leaves TempMovers.
 */
model FactoringReferral {
  id                String   @id @default(cuid())
  carrierId         String
  carrier           Carrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  factoringPartnerId String
  factoringPartner  FactoringPartner @relation(fields: [factoringPartnerId], references: [id], onDelete: Cascade)
  status            FactoringReferralStatus @default(REQUESTED)
  consentTimestamp  DateTime?
  submittedAt       DateTime?
  externalReference String?
  approvedAt        DateTime?
  fundedAt          DateTime?
  referralRevenue   Int?     // cents, when a partner reports it
  internalNotes     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([carrierId, status])
  @@index([factoringPartnerId, status])
}

model Vehicle {
  id                      String        @id @default(cuid())
  workerId                String
  worker                  WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)
  type                    VehicleType
  year                    Int?
  make                    String?
  model                   String?
  plateNumber             String?
  plateState              String?
  vinLast6                String?
  capacityDescription     String?
  hasLiftgate             Boolean       @default(false)
  hasPalletJack           Boolean       @default(false)
  commercialInsurance     Boolean       @default(false)
  insuranceExpiresAt      DateTime?
  registrationExpiresAt   DateTime?
  dotNumber               String?
  mcNumber                String?
  verified                Boolean       @default(false)
  active                  Boolean       @default(true)
  assignments             Assignment[]
}

model Job {
  id                       String          @id @default(cuid())
  customerId               String
  customer                 CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  addressId                String
  address                  Address         @relation(fields: [addressId], references: [id], onDelete: Restrict)
  // Nullable during migration/backfill (see prisma/backfill-geo.ts) — the
  // plan is to backfill every existing job, then enforce non-null once
  // validated. Denormalized here (in addition to living on Address) so
  // market-scoped feed/admin queries don't need a join.
  marketId                 String?
  market                   LaunchMarket?   @relation(fields: [marketId], references: [id], onDelete: SetNull)
  territoryId              String?
  territory                Territory?      @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  latitude                 Decimal?        @db.Decimal(9,6)
  longitude                Decimal?        @db.Decimal(9,6)
  // True when this job was created without Google Maps configured, so
  // latitude/longitude are null and radius-based worker matching silently
  // falls back to market/territory membership alone (see lib/geo.ts).
  // Flags the record for admin review rather than letting the degradation
  // pass unnoticed.
  needsManualGeoReview     Boolean         @default(false)
  title                    String
  description              String?
  type                     JobType
  status                   JobStatus       @default(DRAFT)
  postingMode              JobPostingMode  @default(OPEN_MARKETPLACE)
  startsAt                 DateTime
  estimatedHours           Decimal         @db.Decimal(5, 2)
  minimumHours             Int             @default(3)
  moversRequired           Int             @default(2)
  driversRequired          Int             @default(0)
  customerMoverRateCents   Int
  platformFeePerHourCents  Int             @default(500)
  urgentFeeMode            UrgentFeeMode    @default(HOURLY_FEE)
  urgentPlatformFeePerHourCents Int         @default(700)
  urgentPremiumCents       Int             @default(0)
  bookingProtectionFeeCents Int            @default(995)
  driverFeeModel            DriverFeeModel  @default(NONE)
  routeGrossCents           Int?
  driverPlatformFeePercent  Int?
  driverPlatformFeeCapCents Int?
  estimatedSubtotalCents   Int
  estimatedPlatformFeeCents Int
  estimatedTotalCents      Int
  // Populated only at capture time, from actual approved assignment hours
  // — never equal to the estimate above except by coincidence. Kept
  // separate rather than overwriting the estimate, since both numbers are
  // legitimately meaningful: what the customer was quoted, and what they
  // were actually charged.
  finalLaborCents          Int?
  finalPlatformFeeCents    Int?
  finalTotalCents          Int?
  authorizedAmountCents    Int?
  capturedAmountCents      Int?
  pricingSnapshot          Json?
  capturedAt               DateTime?
  stripePaymentIntentId    String?         @unique
  paymentStatus            PaymentStatus   @default(REQUIRES_PAYMENT_METHOD)
  paymentAttempts          PaymentAttempt[]
  paymentTransactions      PaymentTransaction[]
  tips                     Tip[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  assignments              Assignment[]
  requiredSkills           JobSkill[]
  reviews                  Review[]
  auditLogs                AuditLog[]
  @@index([status, startsAt])
  bookingAccessorials BookingAccessorial[]
  @@index([marketId, status])
  @@index([territoryId, status])
  @@index([addressId])
}

model Assignment {
  id                    String           @id @default(cuid())
  jobId                 String
  job                   Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId              String
  worker                WorkerProfile    @relation(fields: [workerId], references: [id], onDelete: Restrict)
  vehicleId             String?
  vehicle               Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status                AssignmentStatus @default(INVITED)
  agreedEarningsCents   Int
  platformFeeCents      Int              @default(500)
  scheduledHours        Decimal          @db.Decimal(5, 2)
  actualHours           Decimal?         @db.Decimal(5, 2)
  checkInAt             DateTime?
  checkOutAt            DateTime?
  checkInLatitude       Decimal?         @db.Decimal(10, 7)
  checkInLongitude      Decimal?         @db.Decimal(10, 7)
  checkOutLatitude      Decimal?         @db.Decimal(10, 7)
  checkOutLongitude     Decimal?         @db.Decimal(10, 7)
  customerApprovedAt    DateTime?
  disputedAt            DateTime?
  disputeReason         String?
  createdAt             DateTime         @default(now())
  expiresAt             DateTime?
  respondedAt           DateTime?
  payout                Payout?
  @@unique([jobId, workerId])
  @@index([workerId, status])
}

// Not yet wired into the payout route — the list-and-match-recent-transfers
// reconciliation in app/api/payouts/[payoutId]/pay/route.ts remains the
// active mechanism for now (acceptable for a small supervised pilot, not
// durable at scale). This model exists so a real pre-call operation record
// + scheduled reconciliation worker can be built without another schema
// migration when that becomes necessary.
model PayoutOperation {
  id        String @id @default(cuid())
  payoutId  String
  payout    Payout @relation(fields: [payoutId], references: [id], onDelete: Cascade)

  idempotencyKey   String   @unique
  status           PayoutOperationStatus
  stripeTransferId String?
  startedAt        DateTime @default(now())
  completedAt      DateTime?
  lastError        String?

  @@index([payoutId, status])
}

enum PayoutOperationStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model Payout {
  id                  String        @id @default(cuid())
  workerId            String
  worker              WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Restrict)
  assignmentId        String        @unique
  assignment          Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  grossEarningsCents  Int
  adjustmentsCents    Int           @default(0)
  recoveryCents       Int           @default(0)
  netPayoutCents      Int
  stripeTransferId    String?       @unique
  idempotencyKey      String?       @unique
  status              PayoutStatus  @default(PENDING)
  scheduledAt         DateTime?
  paidAt              DateTime?
  // Distinct from paidAt above (which is set at TRANSFERRED time) — this
  // is the true bank-arrival confirmation from payout.paid.
  paidOutAt           DateTime?
  stripePayoutId      String?
  failedAt            DateTime?
  failureReason       String?
  retryCount          Int           @default(0)
  reversedAt          DateTime?
  createdAt           DateTime      @default(now())
  bonusLedgerEntries  BonusLedgerEntry[]
  operations          PayoutOperation[]
}

/**
 * A customer's tip for a completed job or freight load. Deliberately a
 * separate model rather than a field on PaymentTransaction — tips are a
 * distinct transaction with their own lifecycle (charged, then split
 * and transferred to one or more workers, 100% with no platform fee),
 * and conflating them with the job/load's own payment would make both
 * harder to audit independently.
 *
 * Exactly one of jobId/loadId is set, matching the same pattern already
 * used by PaymentAttempt and PaymentTransaction for the same reason: a
 * tip belongs to a moving job OR a freight load, never both.
 */
model Tip {
  id                    String    @id @default(cuid())
  jobId                 String?
  job                   Job? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  loadId                String?
  load                  CarrierRoute? @relation(fields: [loadId], references: [id], onDelete: Cascade)
  customerId            String
  customer              CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amountCents           Int
  stripePaymentIntentId String?   @unique
  idempotencyKey        String?   @unique
  status                TipStatus @default(PROCESSING)
  failureReason         String?
  createdAt             DateTime  @default(now())
  succeededAt           DateTime?
  allocations           TipAllocation[]

  @@index([jobId])
  @@index([loadId])
  @@index([customerId])
}

/**
 * One worker's share of a Tip — a job with multiple approved movers
 * splits the tip evenly across them; a freight load has exactly one
 * assigned driver, so it gets a single allocation for the full amount.
 * Only ever created once the parent Tip's payment has actually
 * succeeded (via the Stripe webhook), never at tip-creation time —
 * there is deliberately no such thing as a payable allocation for a
 * tip that hasn't actually been collected yet.
 */
model TipAllocation {
  id               String       @id @default(cuid())
  tipId            String
  tip              Tip @relation(fields: [tipId], references: [id], onDelete: Cascade)
  workerId         String
  worker           WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Restrict)
  amountCents      Int
  stripeTransferId String?      @unique
  idempotencyKey   String?      @unique
  status           PayoutStatus @default(PENDING)
  paidAt           DateTime?
  // Distinct from paidAt above (set at TRANSFERRED time) — this is the
  // true bank-arrival confirmation, same distinction as Payout.paidOutAt.
  paidOutAt        DateTime?
  stripePayoutId   String?
  failedAt         DateTime?
  failureReason    String?
  reversedAt       DateTime?
  createdAt        DateTime     @default(now())

  @@index([workerId])
  @@index([tipId])
}

model Review {
  id          String        @id @default(cuid())
  jobId       String
  job         Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerId    String
  worker      WorkerProfile @relation("WorkerReviews", fields: [workerId], references: [id], onDelete: Cascade)
  customerId  String
  customer    CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)

  rating      Int
  comment     String?
  tags        ReviewTag[]
  status      ReviewStatus @default(PUBLISHED)

  reportedAt   DateTime?
  reportReason String?
  moderatedAt  DateTime?
  moderatedBy  String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  @@unique([jobId, workerId])
  @@index([workerId, status, createdAt])
  @@index([customerId, createdAt])
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  HIDDEN
  REMOVED
}

enum ReviewTag {
  PUNCTUAL
  PROFESSIONAL
  CAREFUL
  FRIENDLY
  EFFICIENT
  GOOD_COMMUNICATION
}

// Every notification the platform sends — email, SMS, or in-app — goes
// through one record here first, regardless of channel. This is what lets
// lib/notifications/index.ts guarantee idempotency (one row per
// idempotencyKey) and gives support a single place to see delivery history
// per user, instead of Resend/Twilio dashboards being the only record.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  channel   NotificationChannel
  title     String
  body      String
  data      Json?
  idempotencyKey    String   @unique
  status            NotificationStatus @default(QUEUED)
  providerMessageId  String?
  failureReason      String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  bouncedAt          DateTime?
  readAt    DateTime?
  createdAt DateTime @default(now())
  @@index([userId, status, createdAt])
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  BOUNCED
  SUPPRESSED
}

model PricingRule {
  id                      String   @id @default(cuid())
  marketCode              String   @unique
  state                    String?
  city                     String?
  minimumHours            Int      @default(3)
  minimumMovers            Int      @default(2)
  platformFeePerHourCents  Int      @default(500)
  urgentFeeMode            UrgentFeeMode @default(HOURLY_FEE)
  urgentPlatformFeePerHourCents Int @default(700)
  customerBookingProtectionFeeCents Int @default(995)
  waiveMoverSubscriptionUntilFirstJob Boolean @default(true)
  moverSubscriptionCents          Int      @default(1995)
  driverBasicSubscriptionCents     Int      @default(2995)
  ownerOperatorSubscriptionCents   Int      @default(5995)
  fleetSubscriptionCents           Int      @default(14900)
  boxTruckFeePerHourCents           Int      @default(500)
  semiPlatformFeePercent           Int      @default(5)
  semiPlatformFeeCapCents          Int      @default(15000)
  // Admin-configurable fee MODEL per freight service type (the fee AMOUNT
  // fields above are unchanged). Moving labor and local box-truck jobs are
  // always ADD_TO_CUSTOMER and intentionally have no toggle. Freight loads
  // default to DEDUCT_FROM_PROVIDER so quoted prices match load-board norms.
  semiFeeModel                     FeeModel @default(DEDUCT_FROM_PROVIDER)
  freightBoxTruckFeeModel          FeeModel @default(DEDUCT_FROM_PROVIDER)
  fleetIncludedVehicles            Int      @default(5)
  additionalFleetVehicleCents      Int      @default(1500)
  urgentPremiumPercent     Int      @default(20)
  active                   Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}


